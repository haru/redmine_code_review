<div class="code_review">

</div>

<div id="review-form-frame">
  <div id="review-form">

  </div>
</div>

<div id="code-review-assign-form" />

<div id="code-review-assign-link" style="text-align: right;">
  <%
  change_id = ''
  change_id = @change.id if @change
  assignments = @change.code_review_assignments if @change
  attachment_id = @attachment.id if @attachment
  assignments = @attachment.code_review_assignments if @attachment
  -%>

  <%- if User.current.allowed_to?(:assign_code_review, @project) -%>
  <%= raw show_assignments assignments, @project, {:action_type => @action_type, :rev => @rev, :rev_to => @rev_to, :path => @path, :change_id => change_id, :attachment_id => attachment_id} -%>
  <%- end -%>
</div>

<%= content_tag :div, nil, data: {
  cr_init: 'diff-view',
  cr_add_review_url: url_for(controller: 'code_review', action: 'new', id: @project),
  cr_show_review_url: url_for(controller: 'code_review', action: 'show', id: @project),
  cr_add_image: image_tag('edit.png', alt: l(:label_add_review), title: l(:label_add_review)),
  cr_show_image: image_tag('review.png', plugin: 'redmine_code_review', alt: l(:label_show_review), title: l(:label_show_review)),
  cr_show_closed_image: image_tag('closed_review.png', plugin: 'redmine_code_review', alt: l(:label_show_review), title: l(:label_show_review)),
  cr_add_form_title: l(:label_add_review),
  cr_review_dialog_title: l(:code_review),
  cr_repository_id: @repository_id.to_s,
  cr_action_type: @action_type.to_s,
  cr_rev: @rev.to_s,
  cr_rev_to: @rev_to.to_s,
  cr_path: @path.to_s,
  cr_change_id: change_id.to_s,
  cr_attachment_id: @attachment_id.to_s,
  cr_readonly: (!authorize_for('code_review', 'new')).to_s,
  cr_diff: (@action_type == 'diff' || @attachment&.is_diff? == true).to_s,
  cr_reviews: @reviews.map { |review| { id: review.id, line: review.line, file_count: review.file_count, closed: review.is_closed? } }.to_json,
  cr_popup_review_id: @show_review_id
} %>
